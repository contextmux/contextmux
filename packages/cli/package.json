{
  "name": "contextmux",
  "version": "0.2.2",
  "description": "Compile one source of coding rules to CLAUDE.md, AGENTS.md, .cursor/rules and copilot-instructions \u2014 then run tasks through an agent under gates.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md')\""
  },
  "bin": {
    "ctxmux": "./dist/index.js",
    "contextmux": "./dist/index.js"
  },
  "dependencies": {
    "@contextmux/context": "workspace:*",
    "@contextmux/repo": "workspace:*",
    "@contextmux/core": "workspace:*",
    "@contextmux/agent-claude": "workspace:*",
    "@contextmux/runner-local": "workspace:*",
    "@contextmux/tracker-file": "workspace:*",
    "@contextmux/agent-copilot": "workspace:*",
    "@contextmux/forge-github": "workspace:*",
    "@contextmux/tracker-github": "workspace:*",
    "@contextmux/tracker-jira": "workspace:*",
    "@contextmux/agent-cursor": "workspace:*",
    "@contextmux/agent-codex": "workspace:*",
    "@contextmux/eval": "workspace:*",
    "@contextmux/learn": "workspace:*",
    "@contextmux/trajectory": "workspace:*",
    "@contextmux/handoff": "workspace:*",
    "@contextmux/agent-local": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contextmux/contextmux.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/contextmux/contextmux#readme",
  "bugs": {
    "url": "https://github.com/contextmux/contextmux/issues"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "coding-agent",
    "claude",
    "claude-code",
    "claude-md",
    "github-copilot",
    "copilot-instructions",
    "cursor",
    "cursor-rules",
    "codex",
    "agents-md",
    "mcp",
    "code-review",
    "pull-request",
    "automation",
    "jira",
    "cli"
  ]
}

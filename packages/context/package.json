{
  "name": "@contextmux/context",
  "version": "0.2.2",
  "description": "Internal to contextmux \u2014 install `contextmux` instead. Provides canonical agent-context model and compilers for Claude Code, Copilot, Cursor and Codex.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b"
  },

{
  "name": "@contextmux/notifier-teams",
  "version": "0.5.0",
  "description": "Internal to contextmux — install `contextmux` instead. Provides Microsoft Teams as a contextmux notifier.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@contextmux/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contextmux/contextmux.git",
    "directory": "packages/notifier-teams"
  },
  "homepage": "https://github.com/contextmux/contextmux#readme",
  "bugs": {
    "url": "https://github.com/contextmux/contextmux/issues"
  },
  "keywords": [
    "contextmux"
  ]
}
